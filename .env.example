# Local development only. Do not use these credentials in a public deployment.
PROVIDER=auto
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo
GROQ_TRANSLATE_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=

# Natural translated voice (Gemini TTS). Leave GEMINI_API_KEY empty to use the browser's own voices.
# Get a key in Google AI Studio and put it ONLY here / in your host's environment, never in chat or git.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# TTS_PROVIDER=auto            # auto | gemini | none
# TTS_VOICES=Sulafat,Charon,Kore,Puck,Aoede,Fenrir   # one is picked per speaker, stable for the meeting
# TTS_STYLE=                   # set empty if the voice ever reads the style hint aloud
TTS_TIMEOUT_S=10
TTS_CONCURRENCY=3

# Browser-facing LiveKit URL. For local dev the browser and server run on this computer.
LIVEKIT_URL=ws://localhost:7880
# Optional server-side LiveKit URL. Set to http://livekit:7880 when API runs in Docker.
LIVEKIT_HTTP_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Keep empty for local development (a random key is generated at startup).
# Set a long random value before deploying the API.
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Translation limits and audio segmentation tuning.
ASR_TIMEOUT_S=8
TRANSLATE_TIMEOUT_S=8
STALE_AFTER_S=12
PROVIDER_CONCURRENCY=4
VAD_HANGOVER_MS=450
VAD_MIN_SPEECH_MS=250
VAD_MAX_SEGMENT_MS=9000
VAD_MIN_RMS=300
MAX_PARTICIPANTS_PER_ROOM=12
MAX_ROOMS=200
